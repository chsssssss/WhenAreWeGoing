<?xml version="1.0" encoding="utf-8"?>
<!--
   ThumbnailStore가 내부 저장소(files/thumbnails)에 받아두는 게시물 대표 이미지는 자동 백업에서 뺀다.
   Auto Backup은 앱당 25MB로 제한돼 있어서, 이미지 캐시까지 포함하면 사용자가 게시물을 늘릴수록
   한도를 넘겨 SavedPost/Place Room DB(진짜 지켜야 할 데이터)까지 통째로 백업이 조용히 실패할 수 있다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="thumbnails/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="thumbnails/" />
    </device-transfer>
</data-extraction-rules>
